---
/**
 * The valley, and nothing else.
 *
 * This is the engine's own front page: no chrome, no copy, just today's world
 * filling the window. `.genesis` is `height: 100%`, so the host page owes it a
 * sized box — that is what `.hero` and `.hero-scene` below are for. Drop them
 * and the island renders at zero pixels.
 */
import TheGenesis from '@codemanethan/genesis/TheGenesis';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A pixel valley that builds itself from today's date." />
    <title>Genesis</title>
  </head>
  <body>
    <main class="hero">
      <div class="hero-scene">
        <TheGenesis client:only="react" />
      </div>
      <noscript>
        <p class="noscript">
          The valley is generated in the browser, so it needs JavaScript. The
          world is a pure function of the date: same date, same river, same
          towns, same names.
        </p>
      </noscript>
    </main>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    height: 100%;
    margin: 0;
  }
</style>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: #3f7f66;
  }

  .hero-scene {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .noscript {
    position: relative;
    z-index: 2;
    margin: 0;
    padding: 1.2rem;
    color: #fdf8ef;
    font-family:
      system-ui,
      -apple-system,
      'Segoe UI',
      Roboto,
      sans-serif;
    line-height: 1.6;
  }

  /* On a phone the valley is a wide landscape in a tall portrait window, so it
     gets a band rather than the whole screen. */
  @media (max-width: 820px) {
    .hero {
      min-height: 0;
    }

    .hero-scene {
      position: relative;
      inset: auto;
      height: 48svh;
      min-height: 330px;
    }
  }
</style>
